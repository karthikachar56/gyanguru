# ========================================================
# GyanGuru Environment Variables Template (.env.example)
# ========================================================

# Server Configuration
PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.v0kivwb.mongodb.net/gyanguru?retryWrites=true&w=majority

# Frontend Client API Endpoint Configuration
VITE_API_BASE_URL=http://localhost:5050
VITE_APP_TITLE=GyanGuru Student & Admin Portal

# AI PDF Document Intelligence & RAG Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_EMBEDDING_MODEL=gemini-2.5-flash
AI_CONFIDENCE_THRESHOLD=85
RAG_MAX_CITATION_RESULTS=5

# Scraper Bot Engine Configuration
SCRAPER_ENGINE_ENABLED=true
SCRAPER_DEFAULT_SCAN_INTERVAL_MINUTES=10
SCRAPER_USER_AGENT="GyanGuru-GovtBot/1.0 (+https://gyanguru.edu/bot)"

# Security & Session Secrets
JWT_SECRET=your_jwt_secret_key_here
HASH_ALGORITHM=sha256
